{
  "name": "aimentorapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "vercel-build": "EXPO_NO_TELEMETRY=1 CI=1 expo export --platform web",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=\"integration\"",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "npm run lint && npm run test:unit -- --ci && npm run test:integration -- --ci && npm run vercel-build",
    "lint": "eslint src"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 15000,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/"
    ]
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.6",
    "@expo/vector-icons": "^15.1.1",
    "@lottiefiles/dotlottie-react": "^0.19.4",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.6",
    "@react-navigation/drawer": "^7.9.5",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/stack": "^7.8.6",
    "babel-preset-expo": "^55.0.12",
    "expo": "~55.0.8",
    "expo-asset": "~55.0.10",
    "expo-auth-session": "~55.0.9",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.10",
    "expo-device": "~55.0.18",
    "expo-image-picker": "~55.0.14",
    "expo-linear-gradient": "~55.0.9",
    "expo-notifications": "~55.0.24",
    "expo-status-bar": "~55.0.4",
    "expo-web-browser": "~55.0.10",
    "firebase": "^12.11.0",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^3.11.174",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.8.1",
    "vosk-browser": "^0.0.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.21",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
