SUPABASE_URL=
SUPABASE_SERVICE_KEY=
FIREBASE_API_KEY=
# Firebase Admin — required for the student email-exists check (see
# services/firebaseAdmin.js). Locally, drop firebase-service-account.json in
# the repo root instead. On Render, set this to the base64 of that JSON file.
FIREBASE_SERVICE_ACCOUNT_B64=
RESEND_API_KEY=
LEARNING_PATHS_SERVICE_URL=
PORT=3017
# Real-email students: verification email via auth-service, invite links back to the app.
AUTH_SERVICE_URL=
APP_URL=
