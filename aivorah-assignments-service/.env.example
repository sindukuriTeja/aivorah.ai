# Server
PORT=3015

# Supabase — assignments, assignment_submissions, users, teacher_student, user_preferences
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Groq — quiz/submission grading, explanations, quiz generation
GROQ_API_KEY=

# Qdrant — textbook grounding for generate-quiz and worksheet-image grading
QDRANT_URL=
QDRANT_API_KEY=

# Public origin of this service, baked into rendered worksheets so the student
# IME can reach /quiz/transliterate from inside the app's iframe. Optional on
# Render (RENDER_EXTERNAL_URL is used automatically).
PUBLIC_URL=

# Second vision provider (page images) when Gemini is down; comma-separated models, tried in order.
MISTRAL_API_KEY=
MISTRAL_VISION_MODEL=mistral-medium-latest,pixtral-large-latest
# Time budgets for the worksheet pipeline (ms).
GEMINI_TIMEOUT_WITH_FALLBACK_MS=30000
DOCUMENT_MODEL_TIMEOUT_MS=150000
# Chrome/Edge used for Word → PDF and PDF page rendering. Optional: by default
# Puppeteer's own Chrome (npx puppeteer browsers install chrome) or an installed
# Chrome / Edge is found automatically. Windows example:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
PUPPETEER_EXECUTABLE_PATH=
