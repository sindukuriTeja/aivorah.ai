{
  "name": "aivorah-learning-paths-service",
  "version": "1.0.0",
  "description": "Aivorah Learning Paths — standalone microservice (syllabus chapters/topics, topic resource resolution, IB PYP/CBSE practice quiz generation)",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "cisce": "node scripts/cisce-ingest.cjs",
    "cisce:dry-run": "node scripts/cisce-ingest.cjs run --dry-run --resume",
    "cisce:overnight": "bash scripts/cisce-overnight.sh",
    "cisce:coverage": "node scripts/cisce-ingest.cjs coverage --check-supplementary"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "groq-sdk": "^0.5.0",
    "mammoth": "^1.12.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@xenova/transformers": "^2.17.2",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
