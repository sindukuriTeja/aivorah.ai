# B2B Demo Login Credentials (fill in real values in your own .env, never commit real .env)

B2B_TEACHER_EMAIL=
B2B_TEACHER_PASSWORD=

B2B_STUDENT_EMAIL=
B2B_STUDENT_PASSWORD=

B2B_PARENT_EMAIL=
B2B_PARENT_PASSWORD=

# Supabase admin access - used ONLY to reset test accounts between test runs
# (e.g. setting onboarding_completed back to false before onboarding tests).
# The service role key bypasses all security rules - never share it, never
# commit the real value, and never use it in real app code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
