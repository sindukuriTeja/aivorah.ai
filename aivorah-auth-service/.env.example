SUPABASE_URL=
SUPABASE_SERVICE_KEY=
ENCRYPTION_KEY=
PORT=4001

# Needed for /user/send-verification (falls back to Gmail SMTP if RESEND_API_KEY is unset)
RESEND_API_KEY=
EMAIL_USER=
EMAIL_PASS=

# Needed for /user/send-password-reset. Firebase Admin (service account) is
# tried first; if unavailable, falls back to the Firebase REST API using
# FIREBASE_API_KEY. Provide one JSON format, not the raw file:
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_API_KEY=

# Optional overrides for tests/smoke.js's demo-account checks (defaults exist
# in the file, only set these if your demo accounts use different emails)
DEMO_STUDENT_EMAIL=
DEMO_TEACHER_EMAIL=
DEMO_PARENT_EMAIL=
DEMO_ADMIN_EMAIL=
