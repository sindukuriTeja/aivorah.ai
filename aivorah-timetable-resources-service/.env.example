PORT=3021
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Firebase service account JSON, base64-encoded (or FIREBASE_SERVICE_ACCOUNT as raw JSON)
FIREBASE_SERVICE_ACCOUNT_B64=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
# Optional, tried in order: GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-3-flash-preview
# Fallbacks when Gemini fails (out of credits, busy): PDF pages are sent as images
GROQ_API_KEY=
# Optional: GROQ_VISION_MODELS=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
# Optional: OPENROUTER_VISION_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Optional per-call timeouts (ms): IMPORT_AI_TIMEOUT_MS= (default 45000), OPENROUTER_TIMEOUT_MS= (default 120000, free models are slow)
