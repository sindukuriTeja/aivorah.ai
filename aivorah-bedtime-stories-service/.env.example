# Server
PORT=3011

# ElevenLabs — primary TTS narration (with word-level timestamps for highlight sync).
# Falls back to free TikTok TTS (no timestamps) if unset.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
EL_VOICE_GRANDMOTHER=
EL_VOICE_GRANDFATHER=

# Groq — Whisper word-timestamp fallback for cached audio that has no timings yet
GROQ_API_KEY=
